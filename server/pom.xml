<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath /> <!-- lookup parent from repository -->
  </parent>
  <groupId>mucsi96</groupId>
  <artifactId>training-log</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>training-log</name>
  <description>Training log application</description>
  <url />
  <licenses>
    <license />
  </licenses>
  <developers>
    <developer />
  </developers>
  <scm>
    <connection />
    <developerConnection />
    <tag />
    <url />
  </scm>
  <properties>
    <java.version>21</java.version>
    <!-- Spring profile baked into the AOT-processed / native image at build
         time. GraalVM native images resolve their bean definitions during AOT
         processing, so the profile cannot be chosen at runtime any more: build
         one image per profile instead (test, prod). -->
    <app.profile>prod</app.profile>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.azure.spring</groupId>
      <artifactId>spring-cloud-azure-starter-keyvault-secrets</artifactId>
      <exclusions>
        <exclusion>
          <groupId>com.azure</groupId>
          <artifactId>azure-core-http-netty</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- Use JDK HTTP client instead of Netty for Azure SDK (Netty 4.1 vs 4.2 incompatibility with
    Spring Boot 4) -->
    <dependency>
      <groupId>com.azure</groupId>
      <artifactId>azure-core-http-jdk-httpclient</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-devtools</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-liquibase</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
<dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <version>3.13.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.azure.spring</groupId>
        <artifactId>spring-cloud-azure-dependencies</artifactId>
        <version>7.3.0</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Ahead of the version the Azure BOM pins (1.58.0), whose
           native-image.properties forces SLF4J and logback to build-time
           initialization. Spring Boot sets logging up at run time, and the mix
           leaves objects of run-time initialized types in the image heap, which
           the native-image builder rejects. A build cannot undo such a
           directive either: exclude-config does not apply to
           native-image.properties, and initialize-at-run-time for the same
           class is rejected outright. 1.59.0 dropped those directives. Check
           this again when spring-cloud-azure-dependencies moves. -->
      <dependency>
        <groupId>com.azure</groupId>
        <artifactId>azure-core</artifactId>
        <version>1.59.1</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <repositories>
    <repository>
      <id>ossrh</id>
      <url>https://s01.oss.sonatype.org/content/repositories/snapshots</url>
      <releases>
        <enabled>false</enabled>
      </releases>
    </repository>
  </repositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </path>
            <path>
              <groupId>org.hibernate.orm</groupId>
              <artifactId>hibernate-processor</artifactId>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>process-aot</id>
            <configuration>
              <profiles>
                <profile>${app.profile}</profile>
              </profiles>
              <!-- AOT processing refreshes the application context at build
                   time, so every placeholder an auto-configuration condition
                   reads has to resolve, and the Key Vault property source has
                   to be off so the build never reaches out to Azure. These are
                   build-time-only stand-ins: none of them is baked into the
                   image, but the conditions they make match are, so each has
                   to make the same conditions match as the real value does at
                   runtime.
                   The actuator port stands in for the one test-pod.yaml or the
                   Helm release sets. The condition it decides is whether the
                   management endpoints get a context of their own, which turns
                   on the actuator port differing from the server port - not on
                   either number - so this value only has to stay different
                   from the server port, as it is. Running the two on one port
                   at runtime would contradict what the image was built for,
                   and silently: the wiring is already fixed.
                   A new required environment placeholder read by a condition
                   means adding it here too - the build fails with "Could not
                   resolve placeholder" when one is missing. Placeholders only
                   read while creating beans are resolved at runtime and do not
                   belong here, which is why the Key Vault secrets - ${db-url},
                   ${withings-client-id} and the rest - need nothing. -->
              <systemPropertyVariables>
                <spring.cloud.azure.keyvault.secret.property-source-enabled>false</spring.cloud.azure.keyvault.secret.property-source-enabled>
                <SPRING_ACTUATOR_PORT>8182</SPRING_ACTUATOR_PORT>
              </systemPropertyVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.graalvm.buildtools</groupId>
        <artifactId>native-maven-plugin</artifactId>
        <configuration>
          <!-- Pull reachability metadata for libraries that do not ship their
               own (the PostgreSQL JDBC driver, ...). -->
          <metadataRepository>
            <enabled>true</enabled>
          </metadataRepository>
          <buildArgs>
            <!-- musl, to match the Alpine runtime image, and deliberately not
                 a fully static link: static binaries segfault the moment they
                 start in a container, before GraalVM installs its own segfault
                 handler and so with no output at all. Dynamic musl is what the
                 Liberica NIK musl image is built to produce. -->
            <buildArg>--libc=musl</buildArg>
            <buildArg>-H:+ReportExceptionStackTraces</buildArg>
            <!-- azure-core build-time initializes a few Jackson core classes
                 but not everything they hold on to, which would leave objects
                 of run-time initialized types in the image heap. Naming those
                 types one by one turns into whack-a-mole (Base64Variants pulls
                 in Base64Variant, which pulls in its nested
                 PaddingReadBehaviour), hence the whole package. -->
            <buildArg>--initialize-at-build-time=com.fasterxml.jackson.core</buildArg>
            <!-- See native-image.security for why the builder has to ignore
                 jar signatures. -->
            <buildArg>-J-Djava.security.properties=${project.basedir}/native-image.security</buildArg>
          </buildArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>7.23.0</version>
        <configuration>
          <generatorName>java</generatorName>
          <configOptions>
            <sourceFolder>src/gen/java/main</sourceFolder>
            <dateLibrary>java8</dateLibrary>
            <java8>true</java8>
            <useTags>true</useTags>
            <interfaceOnly>true</interfaceOnly>
            <library>native</library>
            <useJakartaEe>true</useJakartaEe>
            <supportUrlQuery>false</supportUrlQuery>
            <additionalModelTypeAnnotations>@lombok.Builder @lombok.AllArgsConstructor
              @SuppressWarnings("all")</additionalModelTypeAnnotations>
          </configOptions>
          <generateApis>false</generateApis>
          <generateApiTests>false</generateApiTests>
          <generateModelTests>false</generateModelTests>
          <generateModelDocumentation>false</generateModelDocumentation>
          <generateSupportingFiles>false</generateSupportingFiles>
          <generateApiDocumentation>false</generateApiDocumentation>
        </configuration>
        <executions>
          <execution>
            <id>withings</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/withings.yml</inputSpec>
              <modelPackage>mucsi96.traininglog.withings</modelPackage>
            </configuration>
          </execution>
          <execution>
            <id>strava</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/strava.yml</inputSpec>
              <modelPackage>mucsi96.traininglog.strava</modelPackage>
            </configuration>
          </execution>
          <execution>
            <id>api</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/api.yml</inputSpec>
              <modelPackage>mucsi96.traininglog.api</modelPackage>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
