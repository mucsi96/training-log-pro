{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "name": "Start server",
      "request": "launch",
      "cargo": { "args": ["build", "--manifest-path", "server/Cargo.toml"] },
      "cwd": "${workspaceFolder}/server",
      "args": ["start", "--environment", "development"],
      "envFile": "${workspaceFolder}/server/.env"
    }
  ]
}
